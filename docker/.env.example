APP_NAME=PKAB
APP_KEY=
APP_URL=http://localhost:8080
APP_DOMAIN=pkab.example.com
APP_TIMEZONE=Asia/Jakarta

# Development host ports
APP_PORT=8080
VITE_PORT=5173
ADMINER_PORT=8081
DB_HOST_PORT=3307

DB_DATABASE=pkab
DB_USERNAME=pkab
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret
MYSQL_VERSION=8.0

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@pkab.example.com
MAIL_FROM_NAME=PKAB

LOG_CHANNEL=stack
LOG_LEVEL=debug

SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
WHACENTER_API_URL=
WHACENTER_DEVICE_ID=

VITE_HMR_HOST=localhost
VITE_VUE_APP_I18N_LOCALE=id
VITE_VUE_APP_I18N_FALLBACK_LOCALE=id

# Production
APP_NETWORK=pkab-internal
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
APP_IMAGE=prismaeco/pkab-app:prod
NGINX_IMAGE=prismaeco/pkab-nginx:prod
RUN_MIGRATIONS=false
CACHE_CONFIG=true
